{
  "extends": "@patchgrid/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "generated"]
}
