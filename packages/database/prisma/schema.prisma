// Patchgrid schema.
//
// Conventions enforced by CI introspection tests (ADR-0023, `pnpm test:schema`):
//   · every id is UUID v7, `String @db.Uuid`, and is NOT a secret
//   · every datetime is `@db.Timestamptz(3)` — Prisma's default is naive `timestamp`
//   · every tenant-owned parent declares `@@unique([orgId, id])`
//   · every FK between two tenant-owned tables references the PAIR `(orgId, id)`,
//     because PostgreSQL runs referential-integrity checks with row security OFF
//   · people are referenced by `membershipId`, never `userId`
//
// Table classes (TENANCY.md §7). The platform class is a closed list, defined once
// in `src/table-classes.ts`; every other table is tenant-owned and ships with its
// RLS policy, generated from `src/rls.ts`, in the same migration that creates it.
//
// Two things Prisma cannot express live as hand-written SQL at the end of the
// migration that creates the table: RLS policies and CHECK constraints. Prisma
// neither models nor diffs either, so they cause no drift.
//
// Optional composite relations are `onDelete: Restrict`, never the default
// `SetNull`: SET NULL on `(orgId, teamId)` would null `orgId` too, and fail.

generator client {
  provider        = "prisma-client"
  output          = "../generated/client"
  moduleFormat    = "esm"
  // `@@unique(…, where: …)` — "one lead per team" and "a domain is verified by one
  // org" are partial unique indexes. Modelled here, so they are not drift.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Extensions are NOT declared here. Prisma's `extensions` property (a preview
// feature) emits `CREATE EXTENSION` into migrations, which run as patchgrid_owner
// — not a superuser, so it would fail. pgvector is created by the bootstrap,
// which runs as the superuser and is the only thing that can (sql/bootstrap.sql).

// ─── Enums ───────────────────────────────────────────────────────────────────
// Mirrored as Zod enums in @patchgrid/contracts; a type-level test in apps/api
// fails `typecheck` if the two drift (ENGINEERING.md §Testing).

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum Plan {
  FREE
  PRO
}

enum AgentVisibility {
  ALL_TICKETS
  OWN_TEAM_ONLY
}

/// Cumulative: REQUESTER ⊂ AGENT ⊂ ADMIN ⊂ OWNER (RBAC.md §3).
enum Role {
  OWNER
  ADMIN
  AGENT
  REQUESTER
}

/// ADR-0033: INVITED is not produced in v1 (the Invitation row is the pending
/// state); REMOVED is terminal and keeps the row so history keeps its author.
enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
  REMOVED
}

/// What `QuotaService` counts (TENANCY.md §8); mirrors `UsageMetric` in contracts.
enum UsageMetric {
  AGENT_SEATS
  TICKETS_CREATED
  STORAGE_BYTES
  AUTOMATION_RULES
  KB_ARTICLES
}

/// Who performed an audited change (DOMAIN.md §7) — so a token's or a platform
/// admin's change is never misread as a colleague's.
enum AuditActorKind {
  MEMBER
  SERVICE
  SYSTEM
  PLATFORM
}

enum MembershipKind {
  HUMAN
  SERVICE_ACCOUNT
}

// ─── Platform class ──────────────────────────────────────────────────────────
// No orgId policy. Reachable before a tenant is known, through runAsPlatform
// (ADR-0022). Nothing here holds tenant content.

/// A tenant, addressed by slug.
model Organization {
  id                        String             @id @default(uuid(7)) @db.Uuid
  name                      String
  /// Format enforced by a CHECK constraint as well as by the contracts schema.
  slug                      String             @unique
  status                    OrganizationStatus @default(ACTIVE)
  plan                      Plan               @default(FREE)
  /// Claimed email domain. Many orgs may claim one; only one may verify it.
  domain                    String?
  domainVerifiedAt          DateTime?          @db.Timestamptz(3)
  allowDomainJoin           Boolean            @default(false)
  defaultJoinRole           Role?
  agentVisibility           AgentVisibility    @default(ALL_TICKETS)
  emailNotificationsEnabled Boolean            @default(true)
  deletionRequestedAt       DateTime?          @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @db.Timestamptz(3)

  slugHistory   OrganizationSlugHistory[]
  refreshTokens RefreshToken[]
  userOrgIndex  UserOrgIndex[]
  apiTokenIndex ApiTokenIndex[]
  memberships   Membership[]
  teams         Team[]
  teamMembers   TeamMembership[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  usageCounters UsageCounter[]

  ticketCounters TicketCounter[]
  categories     Category[]
  slaPolicies    SLAPolicy[]
  tickets        Ticket[]
  comments       Comment[]
  watchers       TicketWatcher[]

  /// "First verified wins" (TENANCY.md §5), as a constraint rather than a check.
  @@unique([domain], where: raw("\"domainVerifiedAt\" IS NOT NULL"), map: "Organization_verified_domain_key")
}

/// Released slugs. Kept forever: a released slug is never reusable (TENANCY.md §2).
model OrganizationSlugHistory {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @db.Uuid
  slug          String   @unique
  releasedAt    DateTime @db.Timestamptz(3)
  /// 302 until here; the reservation outlives it.
  redirectUntil DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

/// A global identity: one email, one account, many memberships.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; a CHECK constraint refuses anything else.
  email           String    @unique
  /// Null only after pseudonymised erasure (ADR-0028).
  passwordHash    String?
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  anonymisedAt    DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  platformAdmin       PlatformAdmin?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerification[]
  userOrgIndex        UserOrgIndex[]
  memberships         Membership[]
}

/// An operator, outside all tenancy. Created only by CLI (RBAC.md §8).
model PlatformAdmin {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user         User       @relation(fields: [userId], references: [id])
  auditEntries AuditLog[]
}

/// Rotating refresh tokens, chained through `replacedById`; presenting a rotated
/// token revokes the chain (ADR-0004). `orgId` null is the tenant-less `pg_id`
/// (ADR-0031); otherwise the `pg_rt_<slug>` for that org.
///
/// Tokens are 256-bit random secrets, so `tokenHash` is SHA-256 — a lookup key.
/// Argon2id is for low-entropy secrets (passwords, API tokens looked up by prefix).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  orgId        String?   @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @unique @db.Uuid
  userAgent    String?
  ip           String?   @db.Inet
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id])
  /// CASCADE, not the default SET NULL: nulling `orgId` would turn a tenant
  /// refresh token into an org-less one — which is what a `pg_id` is (ADR-0031).
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("RefreshTokenChain", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("RefreshTokenChain")

  @@index([userId])
  @@index([orgId])
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// DERIVED projection (ADR-0022): which workspaces may this user enter? Written in
/// the same transaction as its source rows, reconciled nightly, and NEVER read to
/// authorize — hence `…ForDisplay`. The authoritative role is `Membership.role`.
model UserOrgIndex {
  userId           String             @db.Uuid
  orgId            String             @db.Uuid
  roleForDisplay   Role
  statusForDisplay MembershipStatus
  orgSlug          String
  orgName          String
  orgStatus        OrganizationStatus
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@id([userId, orgId])
  @@index([orgId])
}

/// DERIVED projection (ADR-0022): which org does an API-token prefix belong to?
/// No secret, no hash, no scopes. `ApiToken` itself is tenant-owned and lands in M8.
model ApiTokenIndex {
  prefix    String    @id
  orgId     String    @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ─── Tenant-owned ────────────────────────────────────────────────────────────
// orgId + RLS policy + @@unique([orgId, id]) + orgId-first indexes + composite
// foreign keys between each other. Every one is covered by `pnpm test:schema`.

/// A person's — or a service account's — role inside one organization.
model Membership {
  id                    String           @id @default(uuid(7)) @db.Uuid
  orgId                 String           @db.Uuid
  /// Null exactly when `kind` is SERVICE_ACCOUNT (CHECK constraint): an API
  /// token's actor has no human account behind it (ADR-0021).
  userId                String?          @db.Uuid
  role                  Role
  status                MembershipStatus @default(ACTIVE)
  kind                  MembershipKind   @default(HUMAN)
  /// Denormalised from User so hot lists never join the one table where a
  /// missing `where` exposes every customer's employees (ADR-0023).
  displayName           String
  avatarUrl             String?
  emailPrefs            Json             @default("{}")
  invitedByMembershipId String?          @db.Uuid
  joinedAt              DateTime?        @db.Timestamptz(3)
  anonymisedAt          DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  /// Users are pseudonymised, never deleted (ADR-0028); SET NULL would also
  /// break the kind/userId CHECK.
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    Membership?  @relation("MembershipInvitedBy", fields: [orgId, invitedByMembershipId], references: [orgId, id], onDelete: Restrict)
  invited      Membership[] @relation("MembershipInvitedBy")

  teams              TeamMembership[]
  invitationsCreated Invitation[]
  auditEntries       AuditLog[]

  ticketsRequested Ticket[]        @relation("TicketRequester")
  ticketsAssigned  Ticket[]        @relation("TicketAssignee")
  commentsWritten  Comment[]       @relation("CommentAuthor")
  commentsDeleted  Comment[]       @relation("CommentDeletedBy")
  watching         TicketWatcher[] @relation("Watcher")
  watchersAdded    TicketWatcher[] @relation("WatcherAddedBy")

  @@unique([orgId, id])
  @@unique([orgId, userId])
  @@index([orgId, role, status])
  @@index([userId])
}

model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  description String?
  /// Teams are deactivated, never deleted: tickets reference them.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [orgId], references: [id])
  members      TeamMembership[]
  invitations  Invitation[]
  categories   Category[]
  tickets      Ticket[]

  @@unique([orgId, id])
  @@unique([orgId, name])
}

/// Which teams a membership works in (ADR-0025). A member may be in several;
/// leadership lives on the row, so "a lead is a member of the team they lead"
/// is a property of the key.
model TeamMembership {
  orgId        String   @db.Uuid
  teamId       String   @db.Uuid
  membershipId String   @db.Uuid
  isLead       Boolean  @default(false)
  joinedAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  team         Team         @relation(fields: [orgId, teamId], references: [orgId, id])
  membership   Membership   @relation(fields: [orgId, membershipId], references: [orgId, id])

  @@id([orgId, teamId, membershipId])
  @@unique([orgId, teamId], where: raw("\"isLead\""), map: "TeamMembership_single_lead_key")
  @@index([orgId, membershipId])
}

/// Single-use, 7 days. Token `<orgId-base36>.<secret>`; the org half establishes
/// tenant context before the lookup (ADR-0022). Accepted only by an account whose
/// email equals `email` (ADR-0031).
model Invitation {
  id                    String    @id @default(uuid(7)) @db.Uuid
  orgId                 String    @db.Uuid
  /// Stored lower-cased; a CHECK constraint refuses anything else.
  email                 String
  role                  Role
  teamId                String?   @db.Uuid
  /// SHA-256 of a 256-bit secret — see RefreshToken.
  tokenHash             String
  expiresAt             DateTime  @db.Timestamptz(3)
  acceptedAt            DateTime? @db.Timestamptz(3)
  revokedAt             DateTime? @db.Timestamptz(3)
  invitedByMembershipId String    @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  team         Team?        @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Restrict)
  invitedBy    Membership   @relation(fields: [orgId, invitedByMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, tokenHash])
  @@index([orgId, email])
}

/// The tenant's audit log (DOMAIN.md §7, RBAC.md §12). Partitioned by month on
/// `createdAt` in hand-written SQL (ADR-0034), so the key includes it and there
/// is no `@@unique([orgId, id])`: nothing ever references an audit row. Written
/// in the same transaction as the change it records; never updated.
model AuditLog {
  id                   String         @default(uuid(7)) @db.Uuid
  orgId                String         @db.Uuid
  /// What changed: `Membership`, `Invitation`, `Team`, `Organization`, `Ticket`, …
  entityType           String
  entityId             String         @db.Uuid
  /// One of the contracts' audit actions — a string, so the catalogue grows without a migration.
  action               String
  /// `{ field: { from, to } }` for changes; context for events. Never a secret, never a body twice.
  diff                 Json           @default("{}")
  actorKind            AuditActorKind
  actorMembershipId    String?        @db.Uuid
  actorPlatformAdminId String?        @db.Uuid
  /// Set when a platform admin acted inside a support session (ADR-0020); its table arrives in M8.
  supportSessionId     String?        @db.Uuid
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)

  organization  Organization   @relation(fields: [orgId], references: [id])
  actor         Membership?    @relation(fields: [orgId, actorMembershipId], references: [orgId, id], onDelete: Restrict)
  platformAdmin PlatformAdmin? @relation(fields: [actorPlatformAdminId], references: [id], onDelete: Restrict)

  @@id([id, createdAt])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, entityType, entityId, createdAt(sort: Desc)])
  @@index([orgId, actorMembershipId, createdAt(sort: Desc)])
  @@index([orgId, action, createdAt(sort: Desc)])
}

/// Quota counters (TENANCY.md §8). Postgres is authoritative: enforcement is
/// one conditional `UPDATE … WHERE value + n <= limit` inside the transaction
/// that creates the thing being counted, so two creates at the limit cannot
/// both succeed. `period` is `YYYY-MM` (UTC) for a monthly metric and
/// `current` for a point-in-time one. No `id`: the key is the address.
model UsageCounter {
  orgId     String      @db.Uuid
  period    String
  metric    UsageMetric
  /// BigInt: storage is counted in bytes and outgrows an int at 2 GiB.
  value     BigInt      @default(0)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, period, metric])
}

/// The four record types (DOMAIN.md §1); mirrors `ticketTypeSchema` in contracts.
enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  PROBLEM
  CHANGE
}

/// The union of every type's statuses; which pairs are valid is a CHECK (ADR-0002).
enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  CANCELLED
  KNOWN_ERROR
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  IMPLEMENTED
  ROLLED_BACK
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

/// Computed from impact and urgency, never accepted from a client (DOMAIN.md §3); a CHECK holds the matrix.
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketSource {
  PORTAL
  CONSOLE
  EMAIL
  API
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum CommentAuthorKind {
  MEMBER
  SERVICE
  SYSTEM
  AUTOMATION
}

/// Per-type ticket numbers (ADR-0009). The row lock on (org, type) serialises
/// numbering, so it is taken LAST in the create transaction (DOMAIN.md §1).
model TicketCounter {
  orgId     String     @db.Uuid
  type      TicketType
  nextValue Int        @default(1)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, type])
}

/// The taxonomy (DOMAIN.md §5): three levels, names unique per parent,
/// deactivated never deleted, an optional default team walked up the tree.
model Category {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @db.Uuid
  name          String
  parentId      String?  @db.Uuid
  /// 1..3, checked; recomputed for a subtree when it moves.
  depth         Int
  defaultTeamId String?  @db.Uuid
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  parent       Category?    @relation("CategoryTree", fields: [orgId, parentId], references: [orgId, id], onDelete: Restrict)
  children     Category[]   @relation("CategoryTree")
  defaultTeam  Team?        @relation(fields: [orgId, defaultTeamId], references: [orgId, id], onDelete: Restrict)
  tickets      Ticket[]

  @@unique([orgId, id])
  @@unique([orgId, parentId, name])
  /// A top-level name is unique too: NULL parents are distinct to a plain unique.
  @@unique([orgId, name], where: raw("\"parentId\" IS NULL"), map: "Category_root_name_key")
}

/// SLA targets per (type, priority), Incidents and Service Requests only (DOMAIN.md §4.1).
model SLAPolicy {
  id                       String     @id @default(uuid(7)) @db.Uuid
  orgId                    String     @db.Uuid
  ticketType               TicketType
  priority                 Priority
  responseTargetMinutes    Int
  resolutionTargetMinutes  Int
  responseWarningMinutes   Int
  resolutionWarningMinutes Int
  createdAt                DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  tickets      Ticket[]

  @@unique([orgId, id])
  @@unique([orgId, ticketType, priority])
}

/// One table for four record types (ADR-0002). Clock origins are columns, so
/// a reopen moves one forward and a later priority change cannot move it back
/// (DOMAIN.md §4.2). Deadlines are stored, not derived on read.
model Ticket {
  id                       String                   @id @default(uuid(7)) @db.Uuid
  orgId                    String                   @db.Uuid
  number                   Int
  type                     TicketType
  title                    String
  description              String
  status                   TicketStatus             @default(NEW)
  /// Optimistic concurrency: compared on every write, a mismatch is 409.
  version                  Int                      @default(1)
  impact                   Impact
  urgency                  Urgency
  priority                 Priority
  categoryId               String?                  @db.Uuid
  requesterMembershipId    String                   @db.Uuid
  assigneeMembershipId     String?                  @db.Uuid
  teamId                   String?                  @db.Uuid
  slaPolicyId              String?                  @db.Uuid
  responseClockStartedAt   DateTime                 @db.Timestamptz(3)
  resolutionClockStartedAt DateTime                 @db.Timestamptz(3)
  respondBy                DateTime?                @db.Timestamptz(3)
  resolveBy                DateTime?                @db.Timestamptz(3)
  respondedAt              DateTime?                @db.Timestamptz(3)
  resolvedAt               DateTime?                @db.Timestamptz(3)
  closedAt                 DateTime?                @db.Timestamptz(3)
  cancelledAt              DateTime?                @db.Timestamptz(3)
  pausedAt                 DateTime?                @db.Timestamptz(3)
  pausedMinutes            Int                      @default(0)
  responseBreached         Boolean                  @default(false)
  resolutionBreached       Boolean                  @default(false)
  responseWarningSentAt    DateTime?                @db.Timestamptz(3)
  resolutionWarningSentAt  DateTime?                @db.Timestamptz(3)
  reopenCount              Int                      @default(0)
  source                   TicketSource
  /// GENERATED ALWAYS from title and description in the migration — Prisma
  /// cannot declare a generated column, and never writes this one.
  /// The expression is written as Postgres deparses it, which Prisma reads as a
  /// default; anything else and the drift check reports a change.
  searchVector             Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [orgId], references: [id])
  category     Category?       @relation(fields: [orgId, categoryId], references: [orgId, id], onDelete: Restrict)
  requester    Membership      @relation("TicketRequester", fields: [orgId, requesterMembershipId], references: [orgId, id])
  assignee     Membership?     @relation("TicketAssignee", fields: [orgId, assigneeMembershipId], references: [orgId, id], onDelete: Restrict)
  team         Team?           @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Restrict)
  slaPolicy    SLAPolicy?      @relation(fields: [orgId, slaPolicyId], references: [orgId, id], onDelete: Restrict)
  comments     Comment[]
  watchers     TicketWatcher[]

  @@unique([orgId, id])
  @@unique([orgId, type, number])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, assigneeMembershipId, status])
  @@index([orgId, teamId, status])
  @@index([orgId, requesterMembershipId, createdAt(sort: Desc)])
  @@index([orgId, categoryId])
  @@index([searchVector], type: Gin)
  /// The SLA scan's two questions, over open tickets only. The predicate is
  /// written as Postgres deparses it, or the drift check reads a difference.
  @@index([orgId, resolveBy], where: raw("(\"resolveBy\" IS NOT NULL) AND (status = ANY (ARRAY['NEW'::\"TicketStatus\", 'ASSIGNED'::\"TicketStatus\", 'IN_PROGRESS'::\"TicketStatus\", 'PENDING'::\"TicketStatus\"]))"), map: "Ticket_open_resolveBy_idx")
  @@index([orgId, respondBy], where: raw("\"respondedAt\" IS NULL"), map: "Ticket_unresponded_respondBy_idx")
}

/// The thread (DOMAIN.md §7). Internal notes never reach a requester; edits
/// within 15 minutes; deletion is soft.
model Comment {
  id                    String            @id @default(uuid(7)) @db.Uuid
  orgId                 String            @db.Uuid
  ticketId              String            @db.Uuid
  authorMembershipId    String?           @db.Uuid
  authorKind            CommentAuthorKind
  body                  String
  visibility            CommentVisibility
  editedAt              DateTime?         @db.Timestamptz(3)
  deletedAt             DateTime?         @db.Timestamptz(3)
  deletedByMembershipId String?           @db.Uuid
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])
  author       Membership?  @relation("CommentAuthor", fields: [orgId, authorMembershipId], references: [orgId, id], onDelete: Restrict)
  deletedBy    Membership?  @relation("CommentDeletedBy", fields: [orgId, deletedByMembershipId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, id])
  /// Lets an attachment key on all three (ARCHITECTURE.md §Data model).
  @@unique([orgId, ticketId, id])
  @@index([orgId, ticketId, createdAt])
}

/// Access and notifications that are not role-derived (RBAC.md §5). The
/// requester and assignee are implicit watchers and never rows.
model TicketWatcher {
  orgId               String   @db.Uuid
  ticketId            String   @db.Uuid
  membershipId        String   @db.Uuid
  addedByMembershipId String   @db.Uuid
  addedAt             DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])
  member       Membership   @relation("Watcher", fields: [orgId, membershipId], references: [orgId, id])
  addedBy      Membership   @relation("WatcherAddedBy", fields: [orgId, addedByMembershipId], references: [orgId, id])

  @@id([orgId, ticketId, membershipId])
  @@index([orgId, membershipId])
}
