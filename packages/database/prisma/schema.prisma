// Patchgrid schema.
//
// Conventions enforced by CI introspection tests (ADR-0023, `pnpm test:schema`):
//   · every id is UUID v7, `String @db.Uuid`, and is NOT a secret
//   · every datetime is `@db.Timestamptz(3)` — Prisma's default is naive `timestamp`
//   · every tenant-owned parent declares `@@unique([orgId, id])`
//   · every FK between two tenant-owned tables references the PAIR `(orgId, id)`,
//     because PostgreSQL runs referential-integrity checks with row security OFF
//   · people are referenced by `membershipId`, never `userId`
//
// Table classes (TENANCY.md §7). The platform class is a closed list, defined once
// in `src/table-classes.ts`; every other table is tenant-owned and ships with its
// RLS policy, generated from `src/rls.ts`, in the same migration that creates it.
//
// Two things Prisma cannot express live as hand-written SQL at the end of the
// migration that creates the table: RLS policies and CHECK constraints. Prisma
// neither models nor diffs either, so they cause no drift.
//
// Optional composite relations are `onDelete: Restrict`, never the default
// `SetNull`: SET NULL on `(orgId, teamId)` would null `orgId` too, and fail.

generator client {
  provider        = "prisma-client"
  output          = "../generated/client"
  moduleFormat    = "esm"
  // `@@unique(…, where: …)` — "one lead per team" and "a domain is verified by one
  // org" are partial unique indexes. Modelled here, so they are not drift.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Extensions are NOT declared here. Prisma's `extensions` property (a preview
// feature) emits `CREATE EXTENSION` into migrations, which run as patchgrid_owner
// — not a superuser, so it would fail. pgvector is created by the bootstrap,
// which runs as the superuser and is the only thing that can (sql/bootstrap.sql).

// ─── Enums ───────────────────────────────────────────────────────────────────
// Mirrored as Zod enums in @patchgrid/contracts; a type-level test in apps/api
// fails `typecheck` if the two drift (ENGINEERING.md §Testing).

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  /// Terminal: purged, kept as a tombstone so its slug is never reused (ADR-0043).
  DELETED
}

enum Plan {
  FREE
  PRO
}

enum AgentVisibility {
  ALL_TICKETS
  OWN_TEAM_ONLY
}

/// Cumulative: REQUESTER ⊂ AGENT ⊂ ADMIN ⊂ OWNER (RBAC.md §3).
enum Role {
  OWNER
  ADMIN
  AGENT
  REQUESTER
}

/// ADR-0033: INVITED is not produced in v1 (the Invitation row is the pending
/// state); REMOVED is terminal and keeps the row so history keeps its author.
enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
  REMOVED
}

/// What `QuotaService` counts (TENANCY.md §8); mirrors `UsageMetric` in contracts.
enum UsageMetric {
  AGENT_SEATS
  TICKETS_CREATED
  STORAGE_BYTES
  AUTOMATION_RULES
  KB_ARTICLES
}

/// Who performed an audited change (DOMAIN.md §7) — so a token's or a platform
/// admin's change is never misread as a colleague's.
enum AuditActorKind {
  MEMBER
  SERVICE
  SYSTEM
  PLATFORM
}

enum MembershipKind {
  HUMAN
  SERVICE_ACCOUNT
}

// ─── Platform class ──────────────────────────────────────────────────────────
// No orgId policy. Reachable before a tenant is known, through runAsPlatform
// (ADR-0022). Nothing here holds tenant content.

/// A tenant, addressed by slug.
model Organization {
  id                        String             @id @default(uuid(7)) @db.Uuid
  name                      String
  /// Format enforced by a CHECK constraint as well as by the contracts schema.
  slug                      String             @unique
  status                    OrganizationStatus @default(ACTIVE)
  plan                      Plan               @default(FREE)
  /// Claimed email domain. Many orgs may claim one; only one may verify it.
  domain                    String?
  domainVerifiedAt          DateTime?          @db.Timestamptz(3)
  allowDomainJoin           Boolean            @default(false)
  defaultJoinRole           Role?
  agentVisibility           AgentVisibility    @default(ALL_TICKETS)
  emailNotificationsEnabled Boolean            @default(true)
  /// Members without a confirmed second factor cannot open this workspace (ADR-0029, ADR-0045).
  /// Gates the next authentication, never a session already open.
  requireMfa                Boolean            @default(false)
  deletionRequestedAt       DateTime?          @db.Timestamptz(3)
  /// When the purge made this row a tombstone (ADR-0043).
  deletedAt                 DateTime?          @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @db.Timestamptz(3)

  slugHistory   OrganizationSlugHistory[]
  refreshTokens RefreshToken[]
  userOrgIndex  UserOrgIndex[]
  apiTokenIndex ApiTokenIndex[]
  memberships   Membership[]
  teams         Team[]
  teamMembers   TeamMembership[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  usageCounters UsageCounter[]

  ticketCounters  TicketCounter[]
  categories      Category[]
  slaPolicies     SLAPolicy[]
  tickets         Ticket[]
  comments        Comment[]
  watchers        TicketWatcher[]
  notifications   Notification[]
  problemDetails  ProblemDetails[]
  changeDetails   ChangeDetails[]
  changeApprovals ChangeApproval[]
  ticketLinks     TicketLink[]
  attachments     Attachment[]
  assets          Asset[]
  ticketAssets    TicketAsset[]
  articles        KnowledgeArticle[]
  inboundEmails   InboundEmail[]
  supportSessions SupportSession[]
  apiTokens       ApiToken[]
  exports         OrgExport[]
  outboxEvents    OutboxEvent[]
  eventConsumers  EventConsumer[]
  deadLetters     EventDeadLetter[]

  /// "First verified wins" (TENANCY.md §5), as a constraint rather than a check.
  @@unique([domain], where: raw("\"domainVerifiedAt\" IS NOT NULL"), map: "Organization_verified_domain_key")
}

/// Released slugs. Kept forever: a released slug is never reusable (TENANCY.md §2).
model OrganizationSlugHistory {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @db.Uuid
  slug          String   @unique
  releasedAt    DateTime @db.Timestamptz(3)
  /// 302 until here; the reservation outlives it.
  redirectUntil DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

/// A global identity: one email, one account, many memberships.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; a CHECK constraint refuses anything else.
  email           String    @unique
  /// Null only after pseudonymised erasure (ADR-0028).
  passwordHash    String?
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  anonymisedAt    DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  platformAdmin       PlatformAdmin?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerification[]
  userOrgIndex        UserOrgIndex[]
  memberships         Membership[]
  mfaFactors          UserMfaFactor[]
  mfaRecoveryCodes    UserMfaRecovery[]
}

/// An operator, outside all tenancy. Created only by CLI (RBAC.md §8).
model PlatformAdmin {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @unique @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  /// Revoked by CLI; the row stays, because audit rows point at it (ADR-0040).
  revokedAt DateTime? @db.Timestamptz(3)
  /// Reset by every grant: a token issued before it — under an earlier grant — is dead.
  grantedAt DateTime  @default(now()) @db.Timestamptz(3)

  user                 User               @relation(fields: [userId], references: [id])
  auditEntries         AuditLog[]
  platformAuditEntries PlatformAuditLog[]
  supportSessions      SupportSession[]
}

/// Rotating refresh tokens, chained through `replacedById`; presenting a rotated
/// token revokes the chain (ADR-0004). `orgId` null is the tenant-less `pg_id`
/// (ADR-0031); otherwise the `pg_rt_<slug>` for that org.
///
/// Tokens are 256-bit random secrets, so `tokenHash` is SHA-256 — a lookup key.
/// Argon2id is for low-entropy secrets (passwords, API tokens looked up by prefix).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  orgId        String?   @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @unique @db.Uuid
  userAgent    String?
  ip           String?   @db.Inet
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id])
  /// CASCADE, not the default SET NULL: nulling `orgId` would turn a tenant
  /// refresh token into an org-less one — which is what a `pg_id` is (ADR-0031).
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("RefreshTokenChain", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("RefreshTokenChain")

  @@index([userId])
  @@index([orgId])
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// DERIVED projection (ADR-0022): which workspaces may this user enter? Written in
/// the same transaction as its source rows, reconciled nightly, and NEVER read to
/// authorize — hence `…ForDisplay`. The authoritative role is `Membership.role`.
model UserOrgIndex {
  userId                 String             @db.Uuid
  orgId                  String             @db.Uuid
  roleForDisplay         Role
  statusForDisplay       MembershipStatus
  orgSlug                String
  orgName                String
  orgStatus              OrganizationStatus
  /// Mirrored so the picker can say when a pending workspace is purged (ADR-0043).
  orgDeletionRequestedAt DateTime?          @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@id([userId, orgId])
  @@index([orgId])
}

/// DERIVED projection (ADR-0022): which org does an API-token prefix belong to?
/// No secret, no hash, no scopes. `ApiToken` itself is tenant-owned (ADR-0042).
model ApiTokenIndex {
  prefix    String    @id
  orgId     String    @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ─── Tenant-owned ────────────────────────────────────────────────────────────
// orgId + RLS policy + @@unique([orgId, id]) + orgId-first indexes + composite
// foreign keys between each other. Every one is covered by `pnpm test:schema`.

/// A person's — or a service account's — role inside one organization.
model Membership {
  id                    String           @id @default(uuid(7)) @db.Uuid
  orgId                 String           @db.Uuid
  /// Null exactly when `kind` is SERVICE_ACCOUNT (CHECK constraint): an API
  /// token's actor has no human account behind it (ADR-0021).
  userId                String?          @db.Uuid
  role                  Role
  status                MembershipStatus @default(ACTIVE)
  kind                  MembershipKind   @default(HUMAN)
  /// Denormalised from User so hot lists never join the one table where a
  /// missing `where` exposes every customer's employees (ADR-0023).
  displayName           String
  avatarUrl             String?
  emailPrefs            Json             @default("{}")
  invitedByMembershipId String?          @db.Uuid
  joinedAt              DateTime?        @db.Timestamptz(3)
  anonymisedAt          DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  /// Users are pseudonymised, never deleted (ADR-0028); SET NULL would also
  /// break the kind/userId CHECK.
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    Membership?  @relation("MembershipInvitedBy", fields: [orgId, invitedByMembershipId], references: [orgId, id], onDelete: Restrict)
  invited      Membership[] @relation("MembershipInvitedBy")

  teams              TeamMembership[]
  invitationsCreated Invitation[]
  auditEntries       AuditLog[]

  ticketsRequested         Ticket[]           @relation("TicketRequester")
  ticketsAssigned          Ticket[]           @relation("TicketAssignee")
  commentsWritten          Comment[]          @relation("CommentAuthor")
  commentsDeleted          Comment[]          @relation("CommentDeletedBy")
  watching                 TicketWatcher[]    @relation("Watcher")
  watchersAdded            TicketWatcher[]    @relation("WatcherAddedBy")
  changeApprovals          ChangeApproval[]
  ticketLinksCreated       TicketLink[]
  notifications            Notification[]     @relation("NotificationMembership")
  notificationsAsRecipient Notification[]     @relation("NotificationRecipient")
  apiToken                 ApiToken?          @relation("ApiTokenActor")
  apiTokensCreated         ApiToken[]         @relation("ApiTokenCreatedBy")
  apiTokensRevoked         ApiToken[]         @relation("ApiTokenRevokedBy")
  exportsRequested         OrgExport[]
  attachments              Attachment[]
  assetsOwned              Asset[]
  articlesWritten          KnowledgeArticle[]
  inboundEmailsSent        InboundEmail[]
  supportDecisions         SupportSession[]   @relation("SupportDecidedBy")
  supportRevocations       SupportSession[]   @relation("SupportRevokedBy")

  @@unique([orgId, id])
  @@unique([orgId, userId])
  @@index([orgId, role, status])
  @@index([userId])
}

model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  description String?
  /// Teams are deactivated, never deleted: tickets reference them.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [orgId], references: [id])
  members      TeamMembership[]
  invitations  Invitation[]
  categories   Category[]
  tickets      Ticket[]

  @@unique([orgId, id])
  @@unique([orgId, name])
}

/// Which teams a membership works in (ADR-0025). A member may be in several;
/// leadership lives on the row, so "a lead is a member of the team they lead"
/// is a property of the key.
model TeamMembership {
  orgId        String   @db.Uuid
  teamId       String   @db.Uuid
  membershipId String   @db.Uuid
  isLead       Boolean  @default(false)
  joinedAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  team         Team         @relation(fields: [orgId, teamId], references: [orgId, id])
  membership   Membership   @relation(fields: [orgId, membershipId], references: [orgId, id])

  @@id([orgId, teamId, membershipId])
  @@unique([orgId, teamId], where: raw("\"isLead\""), map: "TeamMembership_single_lead_key")
  @@index([orgId, membershipId])
}

/// Single-use, 7 days. Token `<orgId-base36>.<secret>`; the org half establishes
/// tenant context before the lookup (ADR-0022). Accepted only by an account whose
/// email equals `email` (ADR-0031).
model Invitation {
  id                    String    @id @default(uuid(7)) @db.Uuid
  orgId                 String    @db.Uuid
  /// Stored lower-cased; a CHECK constraint refuses anything else.
  email                 String
  role                  Role
  teamId                String?   @db.Uuid
  /// SHA-256 of a 256-bit secret — see RefreshToken.
  tokenHash             String
  expiresAt             DateTime  @db.Timestamptz(3)
  acceptedAt            DateTime? @db.Timestamptz(3)
  revokedAt             DateTime? @db.Timestamptz(3)
  invitedByMembershipId String    @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  team         Team?        @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Restrict)
  invitedBy    Membership   @relation(fields: [orgId, invitedByMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, tokenHash])
  @@index([orgId, email])
}

/// The tenant's audit log (DOMAIN.md §7, RBAC.md §12). Partitioned by month on
/// `createdAt` in hand-written SQL (ADR-0034), so the key includes it and there
/// is no `@@unique([orgId, id])`: nothing ever references an audit row. Written
/// in the same transaction as the change it records; never updated.
model AuditLog {
  id                   String         @default(uuid(7)) @db.Uuid
  orgId                String         @db.Uuid
  /// What changed: `Membership`, `Invitation`, `Team`, `Organization`, `Ticket`, …
  entityType           String
  entityId             String         @db.Uuid
  /// One of the contracts' audit actions — a string, so the catalogue grows without a migration.
  action               String
  /// `{ field: { from, to } }` for changes; context for events. Never a secret, never a body twice.
  diff                 Json           @default("{}")
  actorKind            AuditActorKind
  actorMembershipId    String?        @db.Uuid
  actorPlatformAdminId String?        @db.Uuid
  /// Set when a platform admin read inside a support session (ADR-0020, ADR-0041). No foreign key: the
  /// log is partitioned and append-only, and a row must outlive nothing it names.
  supportSessionId     String?        @db.Uuid
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)

  organization  Organization   @relation(fields: [orgId], references: [id])
  actor         Membership?    @relation(fields: [orgId, actorMembershipId], references: [orgId, id], onDelete: Restrict)
  platformAdmin PlatformAdmin? @relation(fields: [actorPlatformAdminId], references: [id], onDelete: Restrict)

  @@id([id, createdAt])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, entityType, entityId, createdAt(sort: Desc)])
  @@index([orgId, actorMembershipId, createdAt(sort: Desc)])
  @@index([orgId, action, createdAt(sort: Desc)])
}

/// Quota counters (TENANCY.md §8). Postgres is authoritative: enforcement is
/// one conditional `UPDATE … WHERE value + n <= limit` inside the transaction
/// that creates the thing being counted, so two creates at the limit cannot
/// both succeed. `period` is `YYYY-MM` (UTC) for a monthly metric and
/// `current` for a point-in-time one. No `id`: the key is the address.
model UsageCounter {
  orgId     String      @db.Uuid
  period    String
  metric    UsageMetric
  /// BigInt: storage is counted in bytes and outgrows an int at 2 GiB.
  value     BigInt      @default(0)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, period, metric])
}

/// The four record types (DOMAIN.md §1); mirrors `ticketTypeSchema` in contracts.
enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  PROBLEM
  CHANGE
}

/// The union of every type's statuses; which pairs are valid is a CHECK (ADR-0002).
enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  CANCELLED
  KNOWN_ERROR
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  IMPLEMENTED
  ROLLED_BACK
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

/// Computed from impact and urgency, never accepted from a client (DOMAIN.md §3); a CHECK holds the matrix.
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketSource {
  PORTAL
  CONSOLE
  EMAIL
  API
}

/// What a notification is about (DOMAIN.md §8). The wire twin lives in contracts.
enum NotificationType {
  TICKET_CREATED
  TICKET_RAISED_FOR_YOU
  TICKET_ASSIGNED
  COMMENT_PUBLIC
  COMMENT_INTERNAL
  STATUS_CHANGED
  TICKET_REOPENED
  WATCHER_ADDED
  SLA_WARNING
  SLA_BREACHED
  CHANGE_AWAITING_APPROVAL
  CHANGE_APPROVED
  CHANGE_REJECTED
}

/// An upload's life (ADR-0005): `PENDING` from the presign until `complete`
/// sniffs the bytes; only `READY` attachments are listed or served.
enum AttachmentStatus {
  PENDING
  READY
}

/// What an asset is (DOMAIN.md §9.3). Anything finer is its name.
enum AssetType {
  LAPTOP
  DESKTOP
  MONITOR
  PHONE
  TABLET
  PRINTER
  NETWORK
  SERVER
  SOFTWARE
  OTHER
}

/// How a support session ended (ADR-0041).
enum SupportEndReason {
  EXPIRED
  REVOKED
  AUDIT_FAILED
}

/// What the receiving MTA's trusted Authentication-Results said (ADR-0039).
enum AuthVerdict {
  PASS
  FAIL
  NONE
}

/// What became of an inbound message (ADR-0027).
enum InboundOutcome {
  RECEIVED
  CREATED
  THREADED
  UNAUTHENTICATED
  UNKNOWN_SENDER
  AUTO_REPLY
  RATE_LIMITED
  FAILED
}

/// Who reads an article (DOMAIN.md §9.2): its author and admins, agents, or everyone in the org.
enum ArticleVisibility {
  DRAFT
  INTERNAL
  PUBLISHED
}

enum AssetStatus {
  IN_STOCK
  IN_USE
  IN_REPAIR
  RETIRED
}

enum ChangeRisk {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

/// Stored in one canonical direction, read from both ends (DOMAIN.md §1).
enum LinkRelation {
  CAUSED_BY
  RELATES_TO
  RESOLVED_BY
  DUPLICATE_OF
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum CommentAuthorKind {
  MEMBER
  SERVICE
  SYSTEM
  AUTOMATION
}

/// Per-type ticket numbers (ADR-0009). The row lock on (org, type) serialises
/// numbering, so it is taken LAST in the create transaction (DOMAIN.md §1).
model TicketCounter {
  orgId     String     @db.Uuid
  type      TicketType
  nextValue Int        @default(1)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, type])
}

/// The taxonomy (DOMAIN.md §5): three levels, names unique per parent,
/// deactivated never deleted, an optional default team walked up the tree.
model Category {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @db.Uuid
  name          String
  parentId      String?  @db.Uuid
  /// 1..3, checked; recomputed for a subtree when it moves.
  depth         Int
  defaultTeamId String?  @db.Uuid
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [orgId], references: [id])
  parent       Category?          @relation("CategoryTree", fields: [orgId, parentId], references: [orgId, id], onDelete: Restrict)
  children     Category[]         @relation("CategoryTree")
  defaultTeam  Team?              @relation(fields: [orgId, defaultTeamId], references: [orgId, id], onDelete: Restrict)
  tickets      Ticket[]
  articles     KnowledgeArticle[]

  @@unique([orgId, id])
  @@unique([orgId, parentId, name])
  /// A top-level name is unique too: NULL parents are distinct to a plain unique.
  @@unique([orgId, name], where: raw("\"parentId\" IS NULL"), map: "Category_root_name_key")
}

/// SLA targets per (type, priority), Incidents and Service Requests only (DOMAIN.md §4.1).
model SLAPolicy {
  id                       String     @id @default(uuid(7)) @db.Uuid
  orgId                    String     @db.Uuid
  ticketType               TicketType
  priority                 Priority
  responseTargetMinutes    Int
  resolutionTargetMinutes  Int
  responseWarningMinutes   Int
  resolutionWarningMinutes Int
  createdAt                DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  tickets      Ticket[]

  @@unique([orgId, id])
  @@unique([orgId, ticketType, priority])
}

/// One table for four record types (ADR-0002). Clock origins are columns, so
/// a reopen moves one forward and a later priority change cannot move it back
/// (DOMAIN.md §4.2). Deadlines are stored, not derived on read.
model Ticket {
  id                       String                   @id @default(uuid(7)) @db.Uuid
  orgId                    String                   @db.Uuid
  number                   Int
  type                     TicketType
  title                    String
  description              String
  status                   TicketStatus             @default(NEW)
  /// Optimistic concurrency: compared on every write, a mismatch is 409.
  version                  Int                      @default(1)
  impact                   Impact
  urgency                  Urgency
  priority                 Priority
  categoryId               String?                  @db.Uuid
  requesterMembershipId    String                   @db.Uuid
  assigneeMembershipId     String?                  @db.Uuid
  teamId                   String?                  @db.Uuid
  slaPolicyId              String?                  @db.Uuid
  responseClockStartedAt   DateTime                 @db.Timestamptz(3)
  resolutionClockStartedAt DateTime                 @db.Timestamptz(3)
  respondBy                DateTime?                @db.Timestamptz(3)
  resolveBy                DateTime?                @db.Timestamptz(3)
  respondedAt              DateTime?                @db.Timestamptz(3)
  resolvedAt               DateTime?                @db.Timestamptz(3)
  closedAt                 DateTime?                @db.Timestamptz(3)
  cancelledAt              DateTime?                @db.Timestamptz(3)
  pausedAt                 DateTime?                @db.Timestamptz(3)
  pausedMinutes            Int                      @default(0)
  responseBreached         Boolean                  @default(false)
  resolutionBreached       Boolean                  @default(false)
  responseWarningSentAt    DateTime?                @db.Timestamptz(3)
  resolutionWarningSentAt  DateTime?                @db.Timestamptz(3)
  reopenCount              Int                      @default(0)
  source                   TicketSource
  /// GENERATED ALWAYS from title and description in the migration — Prisma
  /// cannot declare a generated column, and never writes this one.
  /// The expression is written as Postgres deparses it, which Prisma reads as a
  /// default; anything else and the drift check reports a change.
  searchVector             Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(3)

  organization  Organization     @relation(fields: [orgId], references: [id])
  category      Category?        @relation(fields: [orgId, categoryId], references: [orgId, id], onDelete: Restrict)
  requester     Membership       @relation("TicketRequester", fields: [orgId, requesterMembershipId], references: [orgId, id])
  assignee      Membership?      @relation("TicketAssignee", fields: [orgId, assigneeMembershipId], references: [orgId, id], onDelete: Restrict)
  team          Team?            @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Restrict)
  slaPolicy     SLAPolicy?       @relation(fields: [orgId, slaPolicyId], references: [orgId, id], onDelete: Restrict)
  comments      Comment[]
  watchers      TicketWatcher[]
  notifications Notification[]
  problem       ProblemDetails?
  change        ChangeDetails?
  approvals     ChangeApproval[]
  linksFrom     TicketLink[]     @relation("LinkFrom")
  linksTo       TicketLink[]     @relation("LinkTo")
  attachments   Attachment[]
  assets        TicketAsset[]
  inboundEmails InboundEmail[]

  @@unique([orgId, id])
  @@unique([orgId, type, number])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, assigneeMembershipId, status])
  @@index([orgId, teamId, status])
  /// The `assigned` and `teams` list branches, keyset-paged on (createdAt, id): without the sort
  /// column, Postgres sorted every row of a busy assignee or team per page (M9 load check).
  @@index([orgId, assigneeMembershipId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, teamId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, requesterMembershipId, createdAt(sort: Desc)])
  @@index([orgId, categoryId])
  @@index([searchVector], type: Gin)
  /// The SLA scan's two questions, over open tickets only. The predicate is
  /// written as Postgres deparses it, or the drift check reads a difference.
  @@index([orgId, resolveBy], where: raw("(\"resolveBy\" IS NOT NULL) AND (status = ANY (ARRAY['NEW'::\"TicketStatus\", 'ASSIGNED'::\"TicketStatus\", 'IN_PROGRESS'::\"TicketStatus\", 'PENDING'::\"TicketStatus\"]))"), map: "Ticket_open_resolveBy_idx")
  @@index([orgId, respondBy], where: raw("\"respondedAt\" IS NULL"), map: "Ticket_unresponded_respondBy_idx")
}

/// The thread (DOMAIN.md §7). Internal notes never reach a requester; edits
/// within 15 minutes; deletion is soft.
model Comment {
  id                    String            @id @default(uuid(7)) @db.Uuid
  orgId                 String            @db.Uuid
  ticketId              String            @db.Uuid
  authorMembershipId    String?           @db.Uuid
  authorKind            CommentAuthorKind
  body                  String
  visibility            CommentVisibility
  editedAt              DateTime?         @db.Timestamptz(3)
  deletedAt             DateTime?         @db.Timestamptz(3)
  deletedByMembershipId String?           @db.Uuid
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])
  author       Membership?  @relation("CommentAuthor", fields: [orgId, authorMembershipId], references: [orgId, id], onDelete: Restrict)
  deletedBy    Membership?  @relation("CommentDeletedBy", fields: [orgId, deletedByMembershipId], references: [orgId, id], onDelete: Restrict)
  attachments  Attachment[]

  @@unique([orgId, id])
  /// Lets an attachment key on all three (ARCHITECTURE.md §Data model).
  @@unique([orgId, ticketId, id])
  @@index([orgId, ticketId, createdAt])
}

/// An in-app notification (DOMAIN.md §8), one row per recipient. `userId` is
/// the delivery address — the one exception to "people are memberships"
/// (ARCHITECTURE.md §Data model) — and `membershipId` ties it to this org.
/// A `dedupeKey` collapses a burst: while one row with a key is unread, the
/// next with the same key bumps its `count` instead of adding a row. The
/// partial unique index is what makes that a constraint, not a hope.
model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  orgId        String           @db.Uuid
  userId       String           @db.Uuid
  membershipId String           @db.Uuid
  type         NotificationType
  title        String
  body         String?
  ticketId     String?          @db.Uuid
  dedupeKey    String?
  count        Int              @default(1)
  readAt       DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  membership   Membership   @relation("NotificationMembership", fields: [orgId, membershipId], references: [orgId, id])
  /// The delivery address must be a member of this org: the pair, not the bare user.
  recipient    Membership   @relation("NotificationRecipient", fields: [orgId, userId], references: [orgId, userId])
  /// Derived data: a ticket that goes takes its notifications with it.
  ticket       Ticket?      @relation(fields: [orgId, ticketId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id])
  @@unique([orgId, membershipId, dedupeKey], where: raw("(\"readAt\" IS NULL)"), map: "Notification_unread_dedupe_key")
  /// The inbox orders by `updatedAt`: a burst folded into an old unread row brings it back to the top.
  @@index([orgId, userId, updatedAt(sort: Desc)])
}

/// Access and notifications that are not role-derived (RBAC.md §5). The
/// requester and assignee are implicit watchers and never rows.
model TicketWatcher {
  orgId               String   @db.Uuid
  ticketId            String   @db.Uuid
  membershipId        String   @db.Uuid
  addedByMembershipId String   @db.Uuid
  addedAt             DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])
  member       Membership   @relation("Watcher", fields: [orgId, membershipId], references: [orgId, id])
  addedBy      Membership   @relation("WatcherAddedBy", fields: [orgId, addedByMembershipId], references: [orgId, id])

  @@id([orgId, ticketId, membershipId])
  @@index([orgId, membershipId])
}

/// A Problem's own fields (ADR-0002): 1:1 with its ticket, written in the ticket's transaction.
model ProblemDetails {
  orgId        String    @db.Uuid
  ticketId     String    @db.Uuid
  rootCause    String?
  workaround   String?
  knownErrorAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])

  @@id([orgId, ticketId])
}

/// A Change's own fields (ADR-0002). All optional while DRAFT; `submit` requires the plan (DOMAIN.md §2.3).
model ChangeDetails {
  orgId              String      @db.Uuid
  ticketId           String      @db.Uuid
  plannedStart       DateTime?   @db.Timestamptz(3)
  plannedEnd         DateTime?   @db.Timestamptz(3)
  risk               ChangeRisk?
  implementationPlan String?
  rollbackPlan       String?
  outcomeNotes       String?

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])

  @@id([orgId, ticketId])
}

/// Append-only: a change rejected and resubmitted collects one row per decision (ADR-0002).
model ChangeApproval {
  id                   String           @id @default(uuid(7)) @db.Uuid
  orgId                String           @db.Uuid
  ticketId             String           @db.Uuid
  approverMembershipId String           @db.Uuid
  decision             ApprovalDecision
  /// The documented last-approver case (DOMAIN.md §2.3, rule 3).
  selfApproved         Boolean          @default(false)
  reason               String?
  decidedAt            DateTime         @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])
  approver     Membership   @relation(fields: [orgId, approverMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@index([orgId, ticketId, decidedAt])
}

/// One fact per row, in its canonical direction; RELATES_TO is normalised so `fromTicketId < toTicketId`.
model TicketLink {
  id                    String       @id @default(uuid(7)) @db.Uuid
  orgId                 String       @db.Uuid
  fromTicketId          String       @db.Uuid
  toTicketId            String       @db.Uuid
  relation              LinkRelation
  createdByMembershipId String       @db.Uuid
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  from         Ticket       @relation("LinkFrom", fields: [orgId, fromTicketId], references: [orgId, id])
  to           Ticket       @relation("LinkTo", fields: [orgId, toTicketId], references: [orgId, id])
  createdBy    Membership   @relation(fields: [orgId, createdByMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, fromTicketId, toTicketId, relation])
  /// A duplicate stands for one survivor: never two, so chains and cycles cannot form (DOMAIN.md §1).
  @@unique([orgId, fromTicketId], where: raw("(relation = 'DUPLICATE_OF'::\"LinkRelation\")"), map: "TicketLink_one_survivor")
  @@index([orgId, toTicketId])
}

/// A file on a ticket, or on one of its comments (ADR-0005, ADR-0037). The
/// bytes live in object storage under `org/<orgId>/…`; this row is the only
/// way to a presigned URL, and it inherits its comment's visibility.
model Attachment {
  id                   String           @id @default(uuid(7)) @db.Uuid
  orgId                String           @db.Uuid
  ticketId             String           @db.Uuid
  commentId            String?          @db.Uuid
  uploaderMembershipId String           @db.Uuid
  filename             String
  /// What the browser said; never trusted for serving.
  declaredMimeType     String
  /// What byte sniffing found at `complete`; what downloads are served as.
  mimeType             String?
  sizeBytes            Int
  storageKey           String
  status               AttachmentStatus @default(PENDING)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  completedAt          DateTime?        @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])
  /// Through the ticket too: an attachment cannot sit on another ticket's comment.
  comment      Comment?     @relation(fields: [orgId, ticketId, commentId], references: [orgId, ticketId, id])
  uploader     Membership   @relation(fields: [orgId, uploaderMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, storageKey])
  @@index([orgId, ticketId, createdAt])
  @@index([orgId, status, createdAt])
}

/// Something the organization owns (DOMAIN.md §9.3). A requester sees the
/// ones they hold; agents see them all. Retired, never deleted, once a ticket
/// names it.
model Asset {
  id                String      @id @default(uuid(7)) @db.Uuid
  orgId             String      @db.Uuid
  name              String
  type              AssetType
  status            AssetStatus @default(IN_STOCK)
  /// Unique per org when set; several assets may have none.
  serialNumber      String?
  ownerMembershipId String?     @db.Uuid
  /// Calendar days, not instants (DOMAIN.md §9.3).
  purchaseDate      DateTime?   @db.Date
  warrantyExpiresAt DateTime?   @db.Date
  notes             String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [orgId], references: [id])
  owner        Membership?   @relation(fields: [orgId, ownerMembershipId], references: [orgId, id])
  tickets      TicketAsset[]

  @@unique([orgId, id])
  @@unique([orgId, serialNumber])
  @@index([orgId, name, id])
  @@index([orgId, ownerMembershipId])
}

/// A ticket raised about an asset. Both ends are the same org's (ADR-0023).
model TicketAsset {
  orgId     String   @db.Uuid
  ticketId  String   @db.Uuid
  assetId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id])
  asset        Asset        @relation(fields: [orgId, assetId], references: [orgId, id])

  @@id([orgId, ticketId, assetId])
  /// "Tickets for this asset", newest first.
  @@index([orgId, assetId, createdAt(sort: Desc)])
}

/// An article in the organization's knowledge base (DOMAIN.md §9.2). Read by
/// visibility, edited against `version`; the slug is fixed at creation.
model KnowledgeArticle {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  orgId              String                   @db.Uuid
  categoryId         String?                  @db.Uuid
  authorMembershipId String                   @db.Uuid
  title              String
  slug               String
  /// Markdown, rendered without raw HTML.
  body               String
  version            Int                      @default(1)
  visibility         ArticleVisibility        @default(DRAFT)
  /// When it last became PUBLISHED; null while it is not.
  publishedAt        DateTime?                @db.Timestamptz(3)
  viewCount          Int                      @default(0)
  /// Generated: title outweighs body, English stemming (DOMAIN.md §9.1).
  searchVector       Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(body, ''::text)), 'B'::\"char\"))"))
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  category     Category?    @relation(fields: [orgId, categoryId], references: [orgId, id])
  author       Membership   @relation(fields: [orgId, authorMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, slug])
  @@index([orgId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, authorMembershipId])
  @@index([orgId, categoryId])
  @@index([searchVector], type: Gin)
}

/// One message that reached a tenant's inbound address (ADR-0027, ADR-0039):
/// why it was or was not trusted, and what it became. Written for every
/// message whose tenant resolved, rejected ones included — that is how an
/// admin sees what was dropped.
model InboundEmail {
  id                 String         @id @default(uuid(7)) @db.Uuid
  orgId              String         @db.Uuid
  /// The message's own Message-ID header, or a digest of its bytes when it has none. One row per message per org.
  messageKey         String
  fromAddress        String
  subject            String
  authVerdict        AuthVerdict    @default(NONE)
  outcome            InboundOutcome @default(RECEIVED)
  senderMembershipId String?        @db.Uuid
  ticketId           String?        @db.Uuid
  /// `org/<orgId>/inbound/<id>.eml` — the message exactly as received, until `rawDeletedAt`.
  rawStorageKey      String
  /// When the retention sweep deleted the raw message; the row stays for the log.
  rawDeletedAt       DateTime?      @db.Timestamptz(3)
  /// `[{ filename, reason }]` for files left out.
  skippedAttachments Json           @default("[]")
  error              String?
  receivedAt         DateTime       @default(now()) @db.Timestamptz(3)
  processedAt        DateTime?      @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  sender       Membership?  @relation(fields: [orgId, senderMembershipId], references: [orgId, id])
  ticket       Ticket?      @relation(fields: [orgId, ticketId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, messageKey])
  @@index([orgId, receivedAt(sort: Desc), id(sort: Desc)])
  /// The per-sender rate limit: this sender's mail in the last hour.
  @@index([orgId, fromAddress, receivedAt])
}

/// A second factor (ADR-0029, ADR-0040). TOTP today; WebAuthn becomes another
/// kind with its own payload. Platform-class: a factor belongs to a person,
/// not to a workspace.
enum MfaFactorKind {
  TOTP
}

model UserMfaFactor {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @db.Uuid
  kind            MfaFactorKind @default(TOTP)
  /// AES-256-GCM under MFA_ENCRYPTION_KEY: TOTP needs the secret itself, so it is encrypted, not hashed.
  secretEncrypted String
  label           String
  /// Set once a code has proved it; an unconfirmed factor expires in an hour.
  confirmedAt     DateTime?     @db.Timestamptz(3)
  /// The last 30-second step a code was accepted for — a code is never accepted twice.
  lastUsedStep    Int?
  lastUsedAt      DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One confirmed TOTP factor per person.
  @@unique([userId, kind], where: raw("\"confirmedAt\" IS NOT NULL"), map: "UserMfaFactor_one_confirmed")
  @@index([userId])
}

/// Ten single-use recovery codes, Argon2id-hashed, shown once (ADR-0029).
model UserMfaRecovery {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// What operators did at the platform level (ADR-0040): grants, revocations,
/// sign-ins, factor enrolment. Their actions on a tenant are also written to
/// that tenant's own log, as actor kind PLATFORM.
model PlatformAuditLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Null for the CLI, which acts as no admin.
  platformAdminId String?  @db.Uuid
  action          String
  targetOrgId     String?  @db.Uuid
  targetUserId    String?  @db.Uuid
  diff            Json     @default("{}")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([platformAdminId, createdAt])
}

enum OrgExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

/// One export of a workspace (ADR-0028, ADR-0044): who asked, and where the
/// zip is while its link lasts. The one-a-day limit is read from here.
model OrgExport {
  id                      String          @id @default(uuid(7)) @db.Uuid
  orgId                   String          @db.Uuid
  requestedByMembershipId String          @db.Uuid
  requestedAt             DateTime        @default(now()) @db.Timestamptz(3)
  status                  OrgExportStatus @default(QUEUED)
  storageKey              String?
  sizeBytes               BigInt?
  readyAt                 DateTime?       @db.Timestamptz(3)
  expiresAt               DateTime?       @db.Timestamptz(3)
  failure                 String?

  organization Organization @relation(fields: [orgId], references: [id])
  requestedBy  Membership   @relation(fields: [orgId, requestedByMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@index([orgId, requestedAt(sort: Desc), id(sort: Desc)])
  /// Ready exports by expiry, for the retention sweep.
  @@index([orgId, status, expiresAt])
}

/// The transactional outbox, read as a per-tenant log (ADR-0049). Written in the
/// transaction that makes the change it reports, so it exists exactly when the
/// change does. Consumers read it in (txn, id) order, below the snapshot
/// horizon, from their own cursor in `EventConsumer`.
model OutboxEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @db.Uuid
  /// The writing transaction, `pg_current_xact_id()`: the log's order. Ids are
  /// assigned at insert and rows appear at commit, so an id order skips events.
  txn        BigInt   @default(dbgenerated("((pg_current_xact_id())::text)::bigint"))
  type       String
  payload    Json
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization     @relation(fields: [orgId], references: [id])
  deadLetters  EventDeadLetter[]

  @@unique([orgId, id])
  @@index([orgId, txn, id])
}

/// One consumer's place in one tenant's log (ADR-0049). Its handler's database
/// effects commit with the cursor that moves past them. A failing event is
/// counted here, and parked once it has failed often enough.
model EventConsumer {
  orgId          String   @db.Uuid
  consumer       String
  cursorTxn      BigInt   @default(0)
  cursorEventId  String   @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  failingEventId String?  @db.Uuid
  failures       Int      @default(0)
  lastError      String?
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, consumer])
}

/// An event a consumer gave up on, and why (ADR-0049). The cursor has moved past
/// it; replaying it is a decision, not a retry.
model EventDeadLetter {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      String    @db.Uuid
  consumer   String
  eventId    String    @db.Uuid
  failures   Int
  error      String
  parkedAt   DateTime  @default(now()) @db.Timestamptz(3)
  replayedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  event        OutboxEvent  @relation(fields: [orgId, eventId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, consumer, eventId])
  @@index([orgId, consumer, parkedAt(sort: Desc)])
}

/// An API token (ADR-0021, ADR-0042): one per service-account membership,
/// which is the actor it authenticates. The secret is never stored, only its
/// Argon2id hash; `prefix` is public and mirrored in `ApiTokenIndex`.
model ApiToken {
  id                    String    @id @default(uuid(7)) @db.Uuid
  orgId                 String    @db.Uuid
  name                  String
  prefix                String
  tokenHash             String
  /// `TokenScope` values, parsed by contracts on every read.
  scopes                String[]
  membershipId          String    @db.Uuid
  createdByMembershipId String    @db.Uuid
  lastUsedAt            DateTime? @db.Timestamptz(3)
  expiresAt             DateTime? @db.Timestamptz(3)
  expiryWarnedAt        DateTime? @db.Timestamptz(3)
  revokedAt             DateTime? @db.Timestamptz(3)
  revokedByMembershipId String?   @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id])
  membership   Membership   @relation("ApiTokenActor", fields: [orgId, membershipId], references: [orgId, id])
  createdBy    Membership   @relation("ApiTokenCreatedBy", fields: [orgId, createdByMembershipId], references: [orgId, id])
  revokedBy    Membership?  @relation("ApiTokenRevokedBy", fields: [orgId, revokedByMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, membershipId])
  @@unique([orgId, prefix])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  /// Live tokens nearing expiry, for the warning sweep.
  @@index([orgId, revokedAt, expiresAt])
}

/// An operator's read-only access to one workspace, asked for by the operator
/// and granted by an owner (ADR-0020, ADR-0041). Its status is its timestamps:
/// requested, then declined or granted, then ended — by expiry, revocation, or
/// an audit write that failed.
model SupportSession {
  id                    String            @id @default(uuid(7)) @db.Uuid
  orgId                 String            @db.Uuid
  platformAdminId       String            @db.Uuid
  reason                String
  requestedAt           DateTime          @default(now()) @db.Timestamptz(3)
  decidedByMembershipId String?           @db.Uuid
  grantedAt             DateTime?         @db.Timestamptz(3)
  declinedAt            DateTime?         @db.Timestamptz(3)
  expiresAt             DateTime?         @db.Timestamptz(3)
  firstUsedAt           DateTime?         @db.Timestamptz(3)
  revokedByMembershipId String?           @db.Uuid
  endedAt               DateTime?         @db.Timestamptz(3)
  endReason             SupportEndReason?

  organization  Organization  @relation(fields: [orgId], references: [id])
  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  decidedBy     Membership?   @relation("SupportDecidedBy", fields: [orgId, decidedByMembershipId], references: [orgId, id])
  revokedBy     Membership?   @relation("SupportRevokedBy", fields: [orgId, revokedByMembershipId], references: [orgId, id])

  @@unique([orgId, id])
  @@index([orgId, requestedAt(sort: Desc), id(sort: Desc)])
  /// Sessions still running, for the expiry sweep and the banner.
  @@index([orgId, endedAt, expiresAt])
}
