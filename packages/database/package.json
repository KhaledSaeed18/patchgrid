{
  "name": "@patchgrid/database",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./generated/client/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma generate && tsx scripts/seed.ts",
    "studio": "prisma studio",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "doctor": "prisma generate && tsx scripts/doctor.ts",
    "test": "vitest run",
    "test:schema": "vitest run --config vitest.schema.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "policy": "tsx scripts/policy.ts",
    "migrations:check": "tsx scripts/migration-safety.ts",
    "migrations:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "platform": "tsx scripts/platform-admin.ts",
    "load:tickets": "prisma generate && tsx scripts/load-tickets.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@patchgrid/contracts": "workspace:*",
    "@patchgrid/eslint-config": "workspace:*",
    "@patchgrid/typescript-config": "workspace:*",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "eslint": "^9",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
