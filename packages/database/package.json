{
  "name": "@patchgrid/database",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./generated/client/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma generate && tsx scripts/seed.ts",
    "studio": "prisma studio",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "doctor": "prisma generate && tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@patchgrid/eslint-config": "workspace:*",
    "@patchgrid/typescript-config": "workspace:*",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "eslint": "^9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
