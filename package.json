{
  "name": "patchgrid",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:bootstrap": "pnpm --filter @patchgrid/database run bootstrap",
    "db:generate": "pnpm --filter @patchgrid/database run generate",
    "db:migrate": "pnpm --filter @patchgrid/database run migrate",
    "db:seed": "pnpm --filter @patchgrid/database run seed",
    "db:studio": "pnpm --filter @patchgrid/database run studio",
    "db:reset": "pnpm --filter @patchgrid/database exec prisma migrate reset --force --skip-seed && pnpm db:bootstrap && pnpm db:seed",
    "db:doctor": "pnpm --filter @patchgrid/database run doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@patchgrid/eslint-config": "workspace:*",
    "@patchgrid/typescript-config": "workspace:*",
    "lefthook": "^2.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@4": "^4.3.2",
      "browserslist": "^4.29.0",
      "nanoid@3": "^3.3.19",
      "nanoid@5": "^5.1.16",
      "postcss@8": "^8.5.28",
      "multer@2": "^2.4.0",
      "mysql2@3": "^3.24.4",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
