{
  "uid": "patchgrid-tenants",
  "title": "Patchgrid \u2014 which tenant is slow",
  "tags": [
    "patchgrid"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request p95 by tenant (ms)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, org) (rate(http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{org}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second by tenant",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (org) (rate(http_request_duration_milliseconds_count[5m]))",
          "legendFormat": "{{org}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors (5xx) per second by tenant",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (org) (rate(http_request_duration_milliseconds_count{http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{org}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slowest routes, p95 (ms)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, http_route) (rate(http_request_duration_milliseconds_bucket[5m]))))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions per request, p95 by route (an N+1 shows here)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, http_route) (rate(db_transactions_per_request_bucket[5m]))))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transaction p95 by tenant (ms)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, org) (rate(db_transaction_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{org}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pool saturation (0\u20131) and callers waiting",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_saturation_ratio",
          "legendFormat": "saturation"
        },
        {
          "refId": "B",
          "expr": "db_pool_waiting",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job p95 by queue and tenant (ms)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue, org) (rate(job_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{queue}} \u00b7 {{org}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failed jobs per minute",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, org) (rate(job_duration_milliseconds_count{outcome=\"failed\"}[5m])) * 60",
          "legendFormat": "{{queue}} \u00b7 {{org}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "SLA breaches by tenant and priority (per hour)",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (org, priority) (increase(sla_breaches_total[1h]))",
          "legendFormat": "{{org}} \u00b7 {{priority}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Quota rejections by tenant and metric",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (org, metric) (increase(quota_rejections_total[1h]))",
          "legendFormat": "{{org}} \u00b7 {{metric}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "RLS refusals \u2014 any value is a bug",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rls_denied_total)",
          "legendFormat": "refused"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Authorization denials per minute by permission",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (permission) (rate(authorization_decisions_total{outcome=\"denied\"}[5m])) * 60)",
          "legendFormat": "{{permission}}"
        }
      ]
    }
  ]
}
