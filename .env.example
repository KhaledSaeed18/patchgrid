# ─── Local infrastructure ─────────────────────────────────────────────────────
# Copy to `.env`. Everything here is local-only; none of it is a real secret.
#
# Ports default to the values in docs/ENGINEERING.md. Override them if something
# else on your machine already owns one — another project's Postgres is the usual
# culprit, and the failure mode ("port is already allocated") is easy to misread.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Postgres roles ───────────────────────────────────────────────────────────
# The roles a managed Postgres allows (ADR-0059). The superuser exists only to
# stand in for the cloud provider: it makes the admin, and nothing else uses it.
# The admin (CREATEROLE, CREATEDB, as RDS's master user) makes the owner and the
# app and their databases. The owner runs migrations and is exempt from the
# tenant policies by owning the tables; the app is bound by them, and the API
# refuses to start if it can act as the owner.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=patchgrid
POSTGRES_TEST_DB=patchgrid_test
POSTGRES_SHADOW_DB=patchgrid_shadow

PATCHGRID_ADMIN_PASSWORD=admin
PATCHGRID_OWNER_PASSWORD=owner
PATCHGRID_APP_PASSWORD=app

# ─── Connection strings ───────────────────────────────────────────────────────
# The application uses DATABASE_URL and must never be given the others.
# The config validator refuses to start if DATABASE_URL == DATABASE_MIGRATION_URL.
DATABASE_URL="postgresql://patchgrid_app:app@localhost:5432/patchgrid?schema=public"
DATABASE_MIGRATION_URL="postgresql://patchgrid_owner:owner@localhost:5432/patchgrid?schema=public"
DATABASE_ADMIN_URL="postgresql://patchgrid_admin:admin@localhost:5432/postgres"
# Only for `db:bootstrap`'s first step, which a provider takes for you on RDS.
DATABASE_SUPERUSER_URL="postgresql://postgres:postgres@localhost:5432/postgres"
TEST_DATABASE_URL="postgresql://patchgrid_app:app@localhost:5432/patchgrid_test?schema=public"
TEST_DATABASE_MIGRATION_URL="postgresql://patchgrid_owner:owner@localhost:5432/patchgrid_test?schema=public"
# Scratch database for `prisma migrate dev` and the CI drift check. Prisma wipes it.
DATABASE_SHADOW_URL="postgresql://patchgrid_owner:owner@localhost:5432/patchgrid_shadow?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Object storage (MinIO locally, S3-compatible in production) ──────────────
MINIO_ROOT_USER=patchgrid
MINIO_ROOT_PASSWORD=patchgrid-local-dev
S3_ENDPOINT="http://localhost:9000"
S3_REGION=us-east-1
S3_BUCKET=patchgrid-attachments
# Static keys for MinIO. Omit both on AWS: the task role supplies credentials.
S3_ACCESS_KEY_ID=patchgrid
S3_SECRET_ACCESS_KEY=patchgrid-local-dev

# ─── Mail (Mailpit locally) ───────────────────────────────────────────────────
# smtp (Mailpit) or ses (the SDK's default region, credentials and endpoint).
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# The envelope sender, as "Name <address>". The display name becomes the
# organization's name on tenant mail (ADR-0018).
MAIL_FROM="Patchgrid <notifications@patchgrid.test>"

# Inbound mail (ADR-0039). The secret signs the webhook; the authserv-id names the
# receiving MTA whose Authentication-Results header is trusted. `pnpm --filter
# @patchgrid/api run inbound:send` uses both to post a sample message.
INBOUND_WEBHOOK_SECRET=whsec_cGF0Y2hncmlkLWxvY2FsLWluYm91bmQtc2VjcmV0
INBOUND_AUTHSERV_ID=mx.inbound.lvh.me

# Encrypts second-factor secrets at rest (ADR-0040). Development only; production keeps its own, apart
# from the database.
MFA_ENCRYPTION_KEY=cGF0Y2hncmlkLWxvY2FsLW1mYS1rZXktMzJieXRlcyE=
# Seals webhook signing secrets at rest (ADR-0050). Development only, and deliberately all zero bytes:
# production keeps its own, apart from the database. The second line lets webhooks reach this machine over
# http — never in production.
WEBHOOK_SECRETS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
# Seals SSO client secrets at rest (ADR-0054). Development only, and deliberately one repeated byte. The
# second line lets an SSO issuer be this machine over http (the Keycloak in `--profile sso`), never in
# production. DNS_RESOLVERS, comma-separated ip[:port], points the domain proof at other nameservers.
SSO_SECRETS_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
SSO_ALLOW_PRIVATE_ISSUERS=true
# With `docker compose --profile dns up -d`, the domain proof reads docker/coredns/zones:
# DNS_RESOLVERS=127.0.0.1:5354
# Mailpit's HTTP API, used only by the mail integration spec.
MAILPIT_URL=http://localhost:8025

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# The registrable domain tenants live under. Every CORS decision derives from it,
# so widening it widens who may call the API with credentials.
ROOT_DOMAIN=lvh.me
# Ports the browser surfaces use in development. MUST be empty in production.
WEB_ORIGIN_PORTS=3000,3001
# Where apps/app is served in development; links in outbound mail use it.
WEB_APP_PORT=3001
DATABASE_POOL_MAX=10
# The outbox wake's LISTEN connection. Unset is DATABASE_URL; behind a
# transaction-mode pooler it must name the database directly (ADR-0049).
# DATABASE_LISTEN_URL=
# all | api | worker — which halves of the process run (ARCHITECTURE.md §Background jobs).
WORKER_MODE=all
# Rate limiting. Only ever "false" for integration specs; never where the API is reachable.
THROTTLE_ENABLED=true
# Production only: proxies between the internet and the API (Express `trust proxy`).
# One for a single ingress; add one per CDN or load balancer in front of it.
TRUST_PROXY_HOPS=1

# ─── Sessions (ADR-0004, ADR-0024, ADR-0031) ──────────────────────────────────
# Signs the 15-minute access token. Local-only value; generate a real one with
# `openssl rand -base64 48`. Rotating it logs everyone out.
JWT_SECRET=local-development-secret-that-is-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Cookies are shared by app., <slug>. and api., so this is the root with a dot.
COOKIE_DOMAIN=.lvh.me

# ─── Observability (ADR-0030) ─────────────────────────────────────────────────
# Traces and metrics go to an OTLP/HTTP collector when this is set; unset, the
# SDK stays off and the API pays nothing. `docker compose --profile observability up`
# runs the collector, Prometheus, Tempo and Grafana (http://localhost:3100).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=patchgrid-api
