# ─── Local infrastructure ─────────────────────────────────────────────────────
# Copy to `.env`. Everything here is local-only; none of it is a real secret.
#
# Ports default to the values in docs/ENGINEERING.md. Override them if something
# else on your machine already owns one — another project's Postgres is the usual
# culprit, and the failure mode ("port is already allocated") is easy to misread.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Postgres roles ───────────────────────────────────────────────────────────
# Three roles, deliberately: the superuser creates extensions and roles; the owner
# runs migrations and holds BYPASSRLS; the app holds neither and never can.
# See ADR-0015 and docs/ENGINEERING.md §Local development.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=patchgrid
POSTGRES_TEST_DB=patchgrid_test
POSTGRES_SHADOW_DB=patchgrid_shadow

PATCHGRID_OWNER_PASSWORD=owner
PATCHGRID_APP_PASSWORD=app

# ─── Connection strings ───────────────────────────────────────────────────────
# The application uses DATABASE_URL and must never be given the others.
# The config validator refuses to start if DATABASE_URL == DATABASE_MIGRATION_URL.
DATABASE_URL="postgresql://patchgrid_app:app@localhost:5432/patchgrid?schema=public"
DATABASE_MIGRATION_URL="postgresql://patchgrid_owner:owner@localhost:5432/patchgrid?schema=public"
DATABASE_SUPERUSER_URL="postgresql://postgres:postgres@localhost:5432/patchgrid"
TEST_DATABASE_URL="postgresql://patchgrid_app:app@localhost:5432/patchgrid_test?schema=public"
TEST_DATABASE_MIGRATION_URL="postgresql://patchgrid_owner:owner@localhost:5432/patchgrid_test?schema=public"
# Scratch database for `prisma migrate dev` and the CI drift check. Prisma wipes it.
DATABASE_SHADOW_URL="postgresql://patchgrid_owner:owner@localhost:5432/patchgrid_shadow?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Object storage (MinIO locally, S3-compatible in production) ──────────────
MINIO_ROOT_USER=patchgrid
MINIO_ROOT_PASSWORD=patchgrid-local-dev
S3_ENDPOINT="http://localhost:9000"
S3_REGION=us-east-1
S3_BUCKET=patchgrid-attachments
S3_ACCESS_KEY_ID=patchgrid
S3_SECRET_ACCESS_KEY=patchgrid-local-dev

# ─── Mail (Mailpit locally) ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
# The envelope sender, as "Name <address>". The display name becomes the
# organization's name on tenant mail (ADR-0018).
MAIL_FROM="Patchgrid <notifications@patchgrid.test>"
# Mailpit's HTTP API, used only by the mail integration spec.
MAILPIT_URL=http://localhost:8025

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# The registrable domain tenants live under. Every CORS decision derives from it,
# so widening it widens who may call the API with credentials.
ROOT_DOMAIN=lvh.me
# Ports the browser surfaces use in development. MUST be empty in production.
WEB_ORIGIN_PORTS=3000,3001
# Where apps/app is served in development; links in outbound mail use it.
WEB_APP_PORT=3001
DATABASE_POOL_MAX=10
# all | api | worker — which halves of the process run (ARCHITECTURE.md §Background jobs).
WORKER_MODE=all
# Rate limiting. Only ever "false" for integration specs; never where the API is reachable.
THROTTLE_ENABLED=true

# ─── Sessions (ADR-0004, ADR-0024, ADR-0031) ──────────────────────────────────
# Signs the 15-minute access token. Local-only value; generate a real one with
# `openssl rand -base64 48`. Rotating it logs everyone out.
JWT_SECRET=local-development-secret-that-is-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Cookies are shared by app., <slug>. and api., so this is the root with a dot.
COOKIE_DOMAIN=.lvh.me
