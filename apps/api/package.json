{
  "name": "@patchgrid/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --builder swc",
    "build": "nest build --builder swc",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:authz": "vitest run src/authz",
    "test:tenancy": "vitest run --config vitest.tenancy.config.ts",
    "inbound:send": "tsx scripts/inbound-send.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/lib-storage": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@patchgrid/contracts": "workspace:*",
    "@patchgrid/database": "workspace:*",
    "@react-email/render": "^2.1.0",
    "bullmq": "^6.3.12",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.9.0",
    "jose": "^6.2.12",
    "mailparser": "^3.9.39",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.1.0",
    "otpauth": "^9.5.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.2.7",
    "@patchgrid/eslint-config": "workspace:*",
    "@patchgrid/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7",
    "eslint": "^9",
    "pino-pretty": "^13.2.0",
    "supertest": "^7",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
