{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "DATABASE_SUPERUSER_URL",
    "TEST_DATABASE_URL",
    "TEST_DATABASE_MIGRATION_URL",
    "POSTGRES_DB",
    "POSTGRES_TEST_DB",
    "PATCHGRID_OWNER_PASSWORD",
    "PATCHGRID_APP_PASSWORD"
  ],
  "globalDependencies": [".env", ".nvmrc"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"]
    },
    "test": {
      "dependsOn": ["generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
