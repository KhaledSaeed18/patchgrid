# The formatting rules Prettier cannot reach: files it does not own, and editors
# opened before anyone runs it.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Markdown gives meaning to trailing whitespace (a hard line break).
trim_trailing_whitespace = false

[*.{sql,sh}]
indent_size = 2

[Makefile]
indent_style = tab
